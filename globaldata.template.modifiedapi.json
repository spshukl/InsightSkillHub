{"$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "databaseAccounts_irt_docdb_name": {
      "defaultValue": null,
      "type": "string"
    },
    "sqlServerPrimaryName": {
      "defaultValue": "irt-ppdi-eastus-dev",
      "type": "string"
    },
    "sqlServerSecondaryName": {
      "defaultValue": "irt-ppdi-westeu-dev",
      "type": "string"
    },
    "servers_irt_ppdi_eastus_dw_name": {
      "defaultValue": "irt-ppdi-eastus-dev-dw",
      "type": "string"
    },
    "databaseAccounts_irt_docdb_preprod_name_1": {
      "defaultValue": "irt-docdb-preprod",
      "type": "string"
    },
    "elasticPoolName": {
      "type": "string"
    },
    "servers_irt_ppdi_eastus_elasticPoolDtu": {
      "type": "string"
    },
    "servers_irt_ppdi_westeu_elasticPoolDtu": {
      "type": "string"
    },
    "sqlFailoverGroupName": {
      "type": "string"
    },
    "databases_irt_ppdi_name": {
      "defaultValue": "irt-ppdi",
      "type": "string"
    },
    "databases_irt_ppdi_name_1": {
      "defaultValue": "irt-ppdi",
      "type": "string"
    },
    "databases_ppdi_name": {
      "defaultValue": "ppdi-dev",
      "type": "string"
    },
    "databaseAccounts_locations": {
      "type": "array"
    },
    "databaseAccounts_sqlPw": {
      "type": "securestring"
    },
    "databaseAccounts_sqlDwPw": {
      "type": "securestring"
    },
    "warehouseScale": {
      "type": "string"
    },
    "multi-region": {
      "type": "string"
    },
    "provisionWarehouse": {
      "type": "string"
    },
    "provisionCosmos": {
      "type": "string"
    },
    "sqlServerRemoteLocation": {
      "type": "string"
    }
  },
  "variables": {},
  "resources": [
    {
      "type": "Microsoft.DocumentDB/databaseAccounts",
      "kind": "GlobalDocumentDB",
      "name": "[parameters('databaseAccounts_irt_docdb_name')]",
      "condition": "[equals(parameters('provisionCosmos'),'true')]",
      "apiVersion": "2015-04-08",
      "location": "[resourceGroup().location]",
      "tags": {},
      "properties": {
        "databaseAccountOfferType": "Standard",
        "name": "[parameters('databaseAccounts_irt_docdb_name')]",
        "locations": "[parameters('databaseAccounts_locations')]"
      },
      "dependsOn": []
    },
    {
      "type": "Microsoft.Sql/servers",
      "kind": "v12.0",
      "name": "[parameters('sqlServerPrimaryName')]",
      "apiVersion": "2021-11-01", 
      "location": "[resourceGroup().location]",
      "properties": {
        "administratorLogin": "ppdAdmin",
        "administratorLoginPassword": "[parameters('databaseAccounts_sqlPw')]"
      },
      "resources": [
        {
          "type": "elasticpools",
          "name": "[parameters('elasticPoolName')]",
          "apiVersion": "2021-11-01",     
          "location": "[resourceGroup().location]",
          "dependsOn": [
            "[resourceId('Microsoft.Sql/servers', parameters('sqlServerPrimaryName'))]"
          ],
         "sku": {
            "name": "StandardPool",
            "tier": "Standard",
            "capacity": "[int(parameters('servers_irt_ppdi_eastus_elasticPoolDtu'))]"
          }, 
         

          "properties": {
            "edition": "Standard",
            "dtu": "[parameters('servers_irt_ppdi_eastus_elasticPoolDtu')]",
            "databaseDtuMin": "0",
            "databaseDtuMax": null
          }
        },
        {
          "apiVersion": "2015-05-01-preview",
          "type": "failoverGroups",
          "condition": "[equals(parameters('multi-region'),'true')]",
          "name": "[parameters('sqlFailoverGroupName')]",
          "properties": {
            "serverName": "[parameters('sqlServerPrimaryName')]",
            "partnerServers": [
              {
                "id": "[resourceId('Microsoft.Sql/servers/', parameters('sqlServerSecondaryName'))]"
              }
            ],
            "readWriteEndpoint": {
              "failoverPolicy": "Automatic",
              "failoverWithDataLossGracePeriodMinutes": 60
            },
            "readOnlyEndpoint": {
              "failoverPolicy": "Disabled"
            },
            "databases": [
              "[resourceId('Microsoft.Sql/servers/databases', parameters('sqlServerPrimaryName'), parameters('databases_irt_ppdi_name'))]"
            ]
          },
          "dependsOn": [
            "[resourceId('Microsoft.Sql/servers/databases', parameters('sqlServerPrimaryName'), parameters('databases_irt_ppdi_name'))]",
            "[resourceId('Microsoft.Sql/servers/elasticpools', parameters('sqlServerSecondaryName'), parameters('elasticPoolName'))]",
            "[resourceId('Microsoft.Sql/servers', parameters('sqlServerPrimaryName'))]",
            "[resourceId('Microsoft.Sql/servers', parameters('sqlServerSecondaryName'))]"
          ]
        },
        {
          "name": "[parameters('databases_irt_ppdi_name')]",
          "type": "databases",
          "apiVersion": "2021-11-01",    
          "location": "[resourceGroup().location]",
          "dependsOn": [
            "[resourceId('Microsoft.Sql/servers',parameters('sqlServerPrimaryName'))]",
            "[resourceId('Microsoft.Sql/servers/elasticpools', parameters('sqlServerPrimaryName'), parameters('elasticPoolName'))]"
          ],
          "properties": {
            "edition": "Standard",
            "requestedServiceObjectiveName": "ElasticPool",
            "elasticPoolName": "[parameters('elasticPoolName')]"
          }
        }
      ],
      "dependsOn": []
    },
    {
      "type": "Microsoft.Sql/servers",
      "kind": "v12.0",
      "condition": "[equals(parameters('provisionWarehouse'),'true')]",
      "name": "[parameters('servers_irt_ppdi_eastus_dw_name')]",
      "apiVersion": "2021-11-01",       
      "location": "[resourceGroup().location]",
      "properties": {
        "administratorLogin": "ppdAdmin",
        "administratorLoginPassword": "[parameters('databaseAccounts_sqlDwPw')]"
      },
      "dependsOn": []
    },
    {
      "type": "Microsoft.Sql/servers",
      "kind": "v12.0",
      "condition": "[equals(parameters('multi-region'),'true')]",
      "name": "[parameters('sqlServerSecondaryName')]",
      "apiVersion": "2021-11-01",       
      "location": "[parameters('sqlServerRemoteLocation')]",
      "properties": {
        "administratorLogin": "ppdAdmin",
        "administratorLoginPassword": "[parameters('databaseAccounts_sqlPw')]",
        "version": "12.0"
      },
      "dependsOn": []
    },
    {
      "apiVersion": "2021-11-01",       
      "dependsOn": [
        "[concat('Microsoft.Sql/servers/', parameters('sqlServerSecondaryName'))]"
      ],
      "location": "[parameters('sqlServerRemoteLocation')]",
      "name": "[concat(parameters('sqlServerSecondaryName'), '/', parameters('elasticPoolName'))]",
      "condition": "[equals(parameters('multi-region'),'true')]",
      "properties": {
        "edition": "Standard",
        "dtu": "[parameters('servers_irt_ppdi_westeu_elasticPoolDtu')]",
        "databaseDtuMin": 0,
        "databaseDtuMax": null
      },
      "type": "Microsoft.Sql/servers/elasticpools"
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "kind": "v12.0,user,datawarehouse",
      "condition": "[equals(parameters('provisionWarehouse'),'true')]",
      "name": "[concat(parameters('servers_irt_ppdi_eastus_dw_name'), '/', parameters('databases_ppdi_name'))]",
      "apiVersion": "2021-11-01",        
      "location": "[resourceGroup().location]",
      "scale": null,
      "properties": {
        "edition": "DataWarehouse",
        "collation": "SQL_Latin1_General_CP1_CI_AS",
        "requestedServiceObjectiveName": "[parameters('warehouseScale')]",
        "containmentState": 2,
        "readScale": "Disabled"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', parameters('servers_irt_ppdi_eastus_dw_name'))]"
      ]
    }
  ]
}